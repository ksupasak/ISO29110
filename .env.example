# Copy to .env and change every password before using on a server. Never commit .env.

# --- Server (docker compose) ---
# Password of the PostgreSQL user "esm" (only applied when the database is first created).
# Postgres uses it raw, and it is repeated inside DATABASE_URL below: use only A-Za-z0-9_-
# characters, or percent-encode it in DATABASE_URL.
POSTGRES_PASSWORD=change-me-db-password
# Inside Compose the database host is "postgres". Use the same password as above.
# (Developers running the app on the host with `npm run dev` use localhost:5432 instead.)
DATABASE_URL=postgresql://esm:change-me-db-password@postgres:5432/esm
# Initial password of the "admin" user, used once by the seed command.
# Blank this value after the first seed so it does not linger in .env.
SEED_ADMIN_PASSWORD=change-me-admin-password
# An existing admin is NOT modified by the seed. Set to true for one run to reset
# the admin's password, role and active flag, then remove it again.
# SEED_RESET_ADMIN=true
# Set to true when the site is served over HTTPS (cookie gets the Secure flag).
SESSION_COOKIE_SECURE=false
# Secret used to encrypt the AI API key stored in the database (at least 16 characters, e.g. `openssl rand -hex 32`).
# Without it the admin cannot save an API key. Changing it later makes the stored key unreadable (re-enter it).
SETTINGS_SECRET=change-me-settings-secret-min-16-chars
# Host port the app is published on (default 3000).
# APP_PORT=3000

# --- Developers only (host machine, npm run dev / npm test / npm run test:e2e) ---
# DATABASE_URL=postgresql://esm:esm@localhost:5432/esm
TEST_DATABASE_URL=postgresql://esm:esm@localhost:5432/esm_test
FILE_STORAGE_DIR=./storage
# Folder with the WP template and sample files (docker compose sets /data/templates itself).
# TEMPLATES_DIR=./templates
