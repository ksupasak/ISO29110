generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SystemRole {
  ADMIN
  USER
}

enum ProjectStatus {
  PLANNING
  ACTIVE
  CLOSED
}

enum ProjectRole {
  PM
  TL
  AN
  PR
  QA
  VIEWER
}

enum AttachmentKind {
  EVIDENCE
  SIGNED
  OTHER
}

model User {
  id                 String            @id @default(cuid())
  username           String            @unique
  passwordHash       String
  fullName           String
  position           String?
  systemRole         SystemRole        @default(USER)
  active             Boolean           @default(true)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  memberships        ProjectMember[]
  sessions           Session[]
  uploads            Attachment[]
  versions           DocumentVersion[]
  tasks              Task[]
  components         Component[]
  approvedMeetings   Meeting[]
  meetingAttendances MeetingAttendee[]
  meetingItems       MeetingItem[]
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model Project {
  id                    String                 @id @default(cuid())
  code                  String                 @unique
  name                  String
  shortName             String?
  customerName          String?
  customerContact       String?
  type                  String                 @default("Internal")
  startDate             DateTime?              @db.Date
  endDate               DateTime?              @db.Date
  budget                Decimal?               @db.Decimal(14, 2)
  devCycle              String?
  status                ProjectStatus          @default(PLANNING)
  description           String?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  members               ProjectMember[]
  wpDocuments           WpDocument[]
  attachments           Attachment[]
  sequences             DocSequence[]
  milestones            Milestone[]
  tasks                 Task[]
  agreementItems        AgreementItem[]
  requirements          Requirement[]
  components            Component[]
  taskRequirements      TaskRequirement[]
  taskComponents        TaskComponent[]
  requirementComponents RequirementComponent[]
  meetings              Meeting[]
  meetingAttendees      MeetingAttendee[]
  meetingItems          MeetingItem[]
}

model ProjectMember {
  id          String        @id @default(cuid())
  projectId   String
  project     Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId      String
  user        User          @relation(fields: [userId], references: [id])
  roles       ProjectRole[]
  primaryRole ProjectRole
  dailyRate   Decimal?      @db.Decimal(10, 2)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@unique([projectId, userId])
  @@index([userId])
}

model WpDocument {
  id             String            @id @default(cuid())
  projectId      String
  project        Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  wpCode         String
  status         String            @default("Draft")
  currentVersion String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  versions       DocumentVersion[]

  @@unique([projectId, wpCode])
}

model DocumentVersion {
  id           String     @id @default(cuid())
  wpDocumentId String
  wpDocument   WpDocument @relation(fields: [wpDocumentId], references: [id], onDelete: Cascade)
  version      String
  note         String?
  attachmentId String     @unique
  attachment   Attachment @relation(fields: [attachmentId], references: [id])
  uploadedById String
  uploadedBy   User       @relation(fields: [uploadedById], references: [id])
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([wpDocumentId, version])
}

model Attachment {
  id              String           @id @default(cuid())
  projectId       String
  project         Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  entityType      String
  entityId        String
  kind            AttachmentKind   @default(OTHER)
  fileName        String
  storedPath      String
  size            Int
  mime            String
  uploadedById    String
  uploadedBy      User             @relation(fields: [uploadedById], references: [id])
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  version         DocumentVersion?
  approvedMeeting Meeting?

  @@index([projectId, entityType, entityId])
}

model Setting {
  key       String   @id
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum TaskStatus {
  TODO
  DOING
  DONE
  BLOCKED
}

enum TaskKind {
  PLAN
  DEV
  FIX
  REVIEW
}

enum RequirementType {
  FUNCTIONAL
  NON_FUNCTIONAL
}

enum RequirementStatus {
  PROPOSED
  APPROVED
  DROPPED
}

enum UnitTestStatus {
  NOT_TESTED
  PASSED
  FAILED
}

/// Per project/prefix/year counter behind generated codes. `year` is 0 for codes without a year.
model DocSequence {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  prefix    String
  year      Int      @default(0)
  lastNo    Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([projectId, prefix, year])
}

model Milestone {
  id          String    @id @default(cuid())
  projectId   String
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  code        String
  name        String
  plannedDate DateTime? @db.Date
  revisedDate DateTime? @db.Date
  actualDate  DateTime? @db.Date
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  tasks       Task[]

  @@unique([projectId, code])
}

model Task {
  id           String            @id @default(cuid())
  projectId    String
  project      Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  code         String
  wbsCode      String?
  parentId     String?
  parent       Task?             @relation("TaskTree", fields: [parentId], references: [id], onDelete: NoAction)
  children     Task[]            @relation("TaskTree")
  title        String
  kind         TaskKind          @default(DEV)
  isoActivity  String?
  qaType       String?
  assigneeId   String?
  assignee     User?             @relation(fields: [assigneeId], references: [id])
  milestoneId  String?
  milestone    Milestone?        @relation(fields: [milestoneId], references: [id], onDelete: NoAction)
  plannedStart DateTime?         @db.Date
  plannedEnd   DateTime?         @db.Date
  actualStart  DateTime?         @db.Date
  actualEnd    DateTime?         @db.Date
  status       TaskStatus        @default(TODO)
  percent      Int               @default(0)
  plannedDays  Decimal?          @db.Decimal(6, 1)
  actualDays   Decimal?          @db.Decimal(6, 1)
  outputWp     String?
  note         String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  requirements TaskRequirement[]
  components   TaskComponent[]
  meetingItems MeetingItem[]

  @@unique([projectId, code])
  @@index([assigneeId])
  @@index([parentId])
  @@index([milestoneId])
}

model AgreementItem {
  id           String        @id @default(cuid())
  projectId    String
  project      Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  code         String
  text         String
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  requirements Requirement[]

  @@unique([projectId, code])
}

model Requirement {
  id              String                 @id @default(cuid())
  projectId       String
  project         Project                @relation(fields: [projectId], references: [id], onDelete: Cascade)
  code            String
  type            RequirementType
  text            String
  priority        String?
  agreementItemId String?
  agreementItem   AgreementItem?         @relation(fields: [agreementItemId], references: [id], onDelete: NoAction)
  designRef       String?
  status          RequirementStatus      @default(PROPOSED)
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  tasks           TaskRequirement[]
  components      RequirementComponent[]

  @@unique([projectId, code])
  @@index([agreementItemId])
}

model Component {
  id             String                 @id @default(cuid())
  projectId      String
  project        Project                @relation(fields: [projectId], references: [id], onDelete: Cascade)
  code           String
  name           String
  description    String?
  ownerId        String?
  owner          User?                  @relation(fields: [ownerId], references: [id])
  unitTestStatus UnitTestStatus         @default(NOT_TESTED)
  version        String?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  tasks          TaskComponent[]
  requirements   RequirementComponent[]

  @@unique([projectId, code])
}

model TaskRequirement {
  projectId     String
  project       Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  taskId        String
  task          Task        @relation(fields: [taskId], references: [id], onDelete: NoAction)
  requirementId String
  requirement   Requirement @relation(fields: [requirementId], references: [id], onDelete: NoAction)
  createdAt     DateTime    @default(now())

  @@id([taskId, requirementId])
  @@index([requirementId])
  @@index([projectId])
}

model TaskComponent {
  projectId   String
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  taskId      String
  task        Task      @relation(fields: [taskId], references: [id], onDelete: NoAction)
  componentId String
  component   Component @relation(fields: [componentId], references: [id], onDelete: NoAction)
  createdAt   DateTime  @default(now())

  @@id([taskId, componentId])
  @@index([componentId])
  @@index([projectId])
}

model RequirementComponent {
  projectId     String
  project       Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  requirementId String
  requirement   Requirement @relation(fields: [requirementId], references: [id], onDelete: NoAction)
  componentId   String
  component     Component   @relation(fields: [componentId], references: [id], onDelete: NoAction)
  createdAt     DateTime    @default(now())

  @@id([requirementId, componentId])
  @@index([componentId])
  @@index([projectId])
}

enum MeetingStatus {
  DRAFT
  APPROVED
}

enum MeetingItemKind {
  ACCOMPLISHED
  ISSUE
  OPEN_ISSUE
  AGREEMENT
}

enum OpenIssueStatus {
  OPEN
  CLOSED
}

/// Meeting Record (WP07). `code` is MR-<Buddhist year>-nn, issued once at creation.
model Meeting {
  id             String            @id @default(cuid())
  projectId      String
  project        Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  code           String
  topic          String
  meetingDate    DateTime          @db.Date
  startTime      String?
  endTime        String?
  place          String?
  recorder       String?
  organizer      String?
  purpose        String?
  previousId     String?
  previous       Meeting?          @relation("MeetingChain", fields: [previousId], references: [id], onDelete: NoAction)
  nextMeetings   Meeting[]         @relation("MeetingChain")
  previousNote   String?
  nextTopic      String?
  nextDate       DateTime?         @db.Date
  nextStartTime  String?
  nextEndTime    String?
  nextPlace      String?
  status         MeetingStatus     @default(DRAFT)
  approvedAt     DateTime?
  approvedById   String?
  approvedBy     User?             @relation(fields: [approvedById], references: [id], onDelete: SetNull)
  approvedFileId String?           @unique
  approvedFile   Attachment?       @relation(fields: [approvedFileId], references: [id], onDelete: SetNull)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  attendees      MeetingAttendee[]
  items          MeetingItem[]

  @@unique([projectId, code])
  @@index([previousId])
}

model MeetingAttendee {
  id           String   @id @default(cuid())
  meetingId    String
  meeting      Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  projectId    String
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  order        Int
  userId       String?
  user         User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  fullName     String
  position     String?
  organization String?
  projectRole  String?
  present      Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([meetingId])
  @@index([projectId])
  @@index([userId])
}

model MeetingItem {
  id            String          @id @default(cuid())
  meetingId     String
  meeting       Meeting         @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  projectId     String
  project       Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  kind          MeetingItemKind
  order         Int
  text          String
  ownerId       String?
  owner         User?           @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  ownerName     String?
  dueDate       DateTime?       @db.Date
  status        OpenIssueStatus @default(OPEN)
  /// The spec's linked_type/linked_id: only tasks in this release.
  taskId        String?
  task          Task?           @relation(fields: [taskId], references: [id], onDelete: NoAction)
  carriedFromId String?
  carriedFrom   MeetingItem?    @relation("IssueCarry", fields: [carriedFromId], references: [id], onDelete: NoAction)
  carriedTo     MeetingItem[]   @relation("IssueCarry")
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([meetingId])
  @@index([projectId])
  @@index([taskId])
  @@index([carriedFromId])
  @@index([ownerId])
}
